[API]
Endpoint=https://api.fsvendas.com.br
ChaveAPI=SUA_CHAVE_API_AQUI

[BANCO_DADOS]
Servidor=localhost
Porta=3050
Database=C:\DADOS\BANCO.FDB
Usuario=SYSDBA
Senha=masterkey

[SYNC]
TempoSegundos=300
AutoIniciar=1

[CONFIG]
QtdCelulares=5
IniciarComWindows=0
MinimizarParaTray=1

[SYNC_ITEMS]
Empresa=1
Usuario=1
Vendedor=1
FormaPagamento=1
Clientes=1
Produtos=0
Pedidos=1
